# Local development only. Never put real credentials in source control.
APP_ENV=local
APP_NAME=icu-champion-challenger
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/icu_mlop

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=icu-deterioration

# Object storage (local MinIO example)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=icu-mlops-artifacts
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

# Data access: configure only in an approved, secure research environment.
# Do not place PhysioNet passwords, tokens, or patient data in this file.
DATA_ROOT=/secure/research-data/icu
